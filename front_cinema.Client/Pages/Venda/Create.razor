@page "/venda/create"


@inject IConfiguration Configuration
@inject HttpClient _http
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.WebUtilities
@using System.Text.Json
@using front_cinema.Client.Components.Filme
@using front_cinema.Client.Components.Sessao
@using front_cinema.Client.Models

<PageTitle>Venda</PageTitle>
<MudText class="mt-5 mb-5" Typo="Typo.h4" GutterBottom="true">Venda</MudText>
<MudGrid>
    <MudItem xs="12">
        <EditForm Model="@model" OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator/>
            <MudGrid>
                <MudItem xs="12" Class="pt-0">
                    @* <MudPaper Style="width: 100%"> *@
                    <MudStepper ShowResetButton>
                        <ChildContent>
                            <MudStep Title="Filme" Class="gap-3 d-flex">
                                <MudItem xs="12">
                                    <FilmeLookupButton OnFilmeSelecionado="OnFilmeSelecionado"/>
                                </MudItem>
                                <MudItem xs="12">
                                    <SessaoLookupButton IdFilme="@idFilmeSelecionado" OnSessaoSelecionada="OnSessaoSelecionada"/>
                                </MudItem>
                            </MudStep>
                            <MudStep Title="Venda">
                                <MudItem xs="12" sm="12">
                                    <MudItem xs="12" sm="12" Class="d-flex">
                                        <MudCardContent Style="width: 20%">
                                            <MudDatePicker Label="Data" Variant="Variant.Outlined"/>
                                        </MudCardContent>
                                        <MudCardContent Style="width: 35%">
                                            <MudTextField Variant="Variant.Outlined" Label="First name" HelperText="Max. 8 characters"
                                            @bind-Value="model.Email" For="@(() => model.Email)"/>
                                        </MudCardContent>
                                        @* <MudCardActions>
                                                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto">Register</MudButton>
                                            </MudCardActions> *@
                                    </MudItem>
                                    <MudItem xs="12" sm="12" Class="d-flex pt-0">
                                        <MudCardContent Style="width: 35%">
                                            <MudTextField Variant="Variant.Outlined" Label="First name" HelperText="Max. 8 characters"
                                            @bind-Value="model.Username" For="@(() => model.Username)"/>
                                        </MudCardContent>
                                    </MudItem>
                                </MudItem>
                            </MudStep>
                            <MudStep Title="Assentos">
                                <MudGrid>
                                    @foreach (Assento assento in assentos)
                                    {
                                        Console.WriteLine(assento.Numero);
                                        <MudItem xs="1">
                                            <MudPaper Class="@($"{GetClasse(assento)} d-flex align-center justify-center")"
                                            Style="width: 100%; height: 80px;" 
                                            @onclick="() => AlternarSelecao(assento)" 
                                            Disabled="@assento.Ocupado" 
                                            Elevation="1">@assento.Numero
                                            </MudPaper>
                                        </MudItem>
                                    }
                                </MudGrid>
                                <MudText Style="margin-top: 20px;" Typo="Typo.h6">Sub-Total: @subTotal</MudText>

                            </MudStep>
                            <MudStep Title="Pagamento">Dados de pagamento</MudStep>
                        </ChildContent>
                        <CompletedContent>
                            Botão de Salvar
                        </CompletedContent>
                    </MudStepper>
                    @* </MudPaper> *@
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudItem>
</MudGrid>


<style>
    .assento {
    border: 2px solid #9e9e9e;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.2s ease;
    }

    .assento-selecionado {
    background-color: #4caf50;
    color: rgb(39,39,47);
    }
    .assento-ocupado {
    background-color: #757575;
    cursor: not-allowed;
    pointer-events: none;
    color: #ddd;
    }
</style>

@code {
    private double subTotal = 25.00;
    private int idFilmeSelecionado = 0;
    private int idSessaoSelecionada = 0;

    @* Assentos *@
    List<Assento> assentos = new List<Assento>();
    protected override void OnInitialized()

    {

    }


    @* Classes Assentos *@
    void AlternarSelecao(Assento assento)
    {
        assento.Selecionado = !assento.Selecionado;
    }
    string GetClasse(Assento assento)
    {
        if (assento.Ocupado) return "assento assento-ocupado";
        return "assento " + (assento.Selecionado ? "assento-selecionado" : "assento-livre");
    }

    async void GetAssentosAsync()
    {
        try
        {
            var baseUrl = Configuration.GetValue<string>("apiBaseUrl");
            var queryParams = new Dictionary<string, string> { };
            if (idSessaoSelecionada != 0 && idSessaoSelecionada != null)
            {
                queryParams.Add("idSessao", idSessaoSelecionada.ToString());
            }

            var url = QueryHelpers.AddQueryString($"{baseUrl}/assento/livre", queryParams);
            var response = await _http.GetStreamAsync($"{url}");
            using var json = await JsonDocument.ParseAsync(response);

            @* Pega o array de assentos livres e adiciona em uma lista da classe assento *@
            assentos.Clear();
            foreach (var item in json.RootElement.GetProperty("assentos").EnumerateArray())
            {
                Assento assento = new Assento();
                assento.Id = item.GetProperty("_id").GetInt32();
                assento.Numero = item.GetProperty("_numero").GetInt32();

                assentos.Add(assento);
            }

            @* Altera para assento não livre *@
            for (int i = 1; i <= json.RootElement.GetProperty("totalAssentos").GetInt32(); i++)
            {
                bool livre = assentos.Any(x => x.Numero == i);
                if (!livre)
                {
                    Assento assentoOcupado = new Assento();
                    assentoOcupado.Numero = i;
                    assentoOcupado.Ocupado = true;
                    assentos.Add(assentoOcupado);
                }
            }

            @* Ordena por número *@
            assentos = assentos.OrderByDescending(x => x.Numero).ToList();
            @* Avisa ao blazor que um componente foi alterado *@
            StateHasChanged();

        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }

    }

    @* Validação padrão do MudBlazor *@
    RegisterAccountForm model = new RegisterAccountForm();
    bool success;

    public class RegisterAccountForm
    {
        [Required]
        [StringLength(8, ErrorMessage = "Name length can't be more than 8.")]
        public string Username { get; set; }

        [Required]
        [EmailAddress]
        public string Email { get; set; }

        [Required]
        [StringLength(30, ErrorMessage = "Password must be at least 8 characters long.", MinimumLength = 8)]
        public string Password { get; set; }

        [Required]
        [Compare(nameof(Password))]
        public string Password2 { get; set; }

    }

    private void OnValidSubmit(EditContext context)
    {
        success = true;
        StateHasChanged();
    }

    @* Retorna id do filme selecionado *@
    private void OnFilmeSelecionado(int id)
    {
        idFilmeSelecionado = id;
    }

@* Retorna id do filme selecionado *@
    private void OnSessaoSelecionada(int id)
    {
        idSessaoSelecionada = id;
        GetAssentosAsync();
    }
}