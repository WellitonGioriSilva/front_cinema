@page "/venda/ingresso"

@using System.Net.Http.Json
@using System.Text.Json
@using front_cinema.Client.Models
@using front_cinema.Client.Components.Geral
@using Microsoft.AspNetCore.WebUtilities
@using front_cinema.Client.Components.Cliente
@inject HttpClient _http
@inject IConfiguration Configuration
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Vendas de Ingressos</PageTitle>
<MudText class="mt-5 mb-5" Typo="Typo.h4" GutterBottom="true">Vendas de Ingressos</MudText>

<form action="">
    <MudGrid Spacing="2" Class="align-center" Justify="Justify.SpaceBetween">
        <MudItem xs="12" md="8" Class="py-2">
            <ClienteLookupButton idCliente="@idCliente" nomeCliente="@nomeCliente" OnClienteSelecionada="OnClienteSelecionada" />
        </MudItem>

        <MudItem xs="12" md="2" Class="py-2 d-flex justify-end">
            <MudButton OnClick="LimparFiltros" Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.Clear"
                Color="Color.Primary" Class="mud-width-full" Style="min-height: 45px; font-size: 1.0rem;">
                Limpar Filtros
            </MudButton>
        </MudItem>
        <MudItem xs="12" md="2" Class="py-2 d-flex justify-end">
            <MudButton Href="venda/ingresso/create" Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.Add"
                Color="Color.Success" Class="mud-width-full" Style="min-height: 45px; font-size: 1.0rem;">
                Novo
            </MudButton>
        </MudItem>

        <MudItem xs="12">
            <MudTable Items="@vendas">
                <ColGroup>
                    <col style="width: 5%;" />
                    <col style="width: 50%;" />
                    <col style="width: 20%;" />
                    <col style="width: 15%;" />
                    <col style="width: 10%;" />
                </ColGroup>
                <HeaderContent>
                    <MudTh>Id</MudTh>
                    <MudTh>Cliente</MudTh>
                    <MudTh>Data</MudTh>
                    <MudTh>Total</MudTh>
                    <MudTh Style="text-align:center">Ações</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Id">@context.Id</MudTd>
                    <MudTd DataLabel="Cliente">@context.Cliente.Nome</MudTd>
                    <MudTd DataLabel="Data">@context.Data.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd DataLabel="Total">@context.Total.ToString("C2")</MudTd>
                    <MudTd DataLabel="Ações" Style="text-align:right">
                        <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" Size="Size.Small"
                            OnClick="@(() => OnEdit(context))" />
                        <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Delete" Size="Size.Small"
                            @onclick="@(() => OnDelete(context))" />
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudItem>
    </MudGrid>
</form>

@code {
    private List<Venda> vendas = new List<Venda>();
    private int idCliente;
    private string nomeCliente;

    protected override async Task OnInitializedAsync()
    {
        await GetVendasAsync();
    }

    @* Retorna id do cliente selecionado *@
    async void OnClienteSelecionada(Cliente cliente)
    {
        idCliente = cliente.Id;
        nomeCliente = cliente.Nome;
        await GetVendasAsync();
    }
    async void LimparFiltros()
    {
        idCliente = 0;
        nomeCliente = "";
        await GetVendasAsync();
    }

    @* Chama Api *@
    async Task<List<Venda>> GetVendasAsync()
    {
        try
        {
            var queryParams = new Dictionary<string, string> { };
            if (idCliente != 0)
            {
                queryParams.Add("idCliente", idCliente.ToString());
            }
            var url = QueryHelpers.AddQueryString($"venda/ingresso", queryParams);
            vendas = await _http.GetFromJsonAsync<List<Venda>>($"{url}");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }

        return vendas;
    }

    @* Ações Lista *@
    void OnEdit(Venda venda)
    {
        NavigationManager.NavigateTo($"/venda/ingresso/update/{venda.Id}");
    }

    private async Task OnDelete(Venda venda)
    {
        var parameters = new DialogParameters<DialogoDelecao>
        {
        { x => x.ContentText, "Deseja realmente deletar essa venda?" },
        { x => x.ButtonText, "Deletar" },
        { x => x.Color, Color.Error }
        };

        var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };

        var dialog = await DialogService.ShowAsync<DialogoDelecao>("Delete", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var response = await _http.DeleteAsync($"venda/ingresso/{venda.Id}");
            if(!response.IsSuccessStatusCode){
                var json = await response.Content.ReadAsStringAsync();
                var errors = JsonSerializer.Deserialize<ResponseApi>(json, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });

                if (errors?.Errors != null)
                {
                    foreach (var errorList in errors.Errors.Values)
                    {
                        foreach (var message in errorList)
                        {
                            Snackbar.Add(message, Severity.Error);
                        }
                    }
                }

                return;
            }else{
                Snackbar.Add("Venda cancelada com sucesso!", Severity.Success);
                await GetVendasAsync();
            }
        }
    }
}