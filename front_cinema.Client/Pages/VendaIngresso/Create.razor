@page "/venda/ingresso/create"

@inject IConfiguration Configuration
@inject HttpClient _http
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.WebUtilities
@using System.Text.Json
@using front_cinema.Client.Components.Filme
@using front_cinema.Client.Components.Sessao
@using front_cinema.Client.Components.Cliente
@using front_cinema.Client.Components.Caixa
@using front_cinema.Client.Components.FormaPagamento
@using front_cinema.Client.Models
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>Venda de Ingressos</PageTitle>
<MudText class="mt-5 mb-5" Typo="Typo.h4" GutterBottom="true">Venda de Ingressos</MudText>
<MudGrid>
    <MudItem xs="12">
        <EditForm Model="@venda" OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />
            <MudGrid>
                <MudItem xs="12" Class="pt-0">
                    @* <MudPaper Style="width: 100%"> *@
                    <MudStepper ShowResetButton ActiveIndexChanged="OnStepChanged">
                        <ChildContent>
                            <MudStep Title="Filme" Class="gap-3 d-flex">
                                <MudItem xs="12">
                                    <FilmeLookupButton OnFilmeSelecionado="OnFilmeSelecionado" />
                                </MudItem>
                                <MudItem xs="12">
                                    <SessaoLookupButton IdFilme="@idFilmeSelecionado"
                                    OnSessaoSelecionada="OnSessaoSelecionada" />
                                </MudItem>
                            </MudStep>
                            <MudStep Title="Assentos">
                                @if (assentos.Count() > 0)
                                {
                                    <MudGrid>
                                        @foreach (Assento assento in assentos)
                                        {
                                            <MudItem xs="1">
                                                <MudPaper Class="@($"{GetClasse(assento)} d-flex align-center justify-center")"
                                                Style="width: 100%; height: 80px;" @onclick="() => AlternarSelecao(assento)"
                                                Disabled="@assento.Ocupado" Elevation="1">@assento.Numero
                                                </MudPaper>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                }
                                else
                                {
                                    <MudText>Selecione um Filme e uma Sessão para selecionar os Assentos!</MudText>
                                }
                                <MudText Style="margin-top: 20px;" Typo="Typo.h6">Sub-Total: @subTotal.ToString("C2")
                                </MudText>

                            </MudStep>
                            <MudStep Title="Venda">
                                @if (assentos.Count() > 0)
                                {
                                    <MudItem xs="12" sm="12">
                                        <MudItem xs="12" sm="12" Class="d-flex">
                                            <MudCardContent Style="width: 50%">
                                                <ClienteLookupButton OnClienteSelecionada="OnClienteSelecionada"/>
                                            </MudCardContent>
                                            <MudCardContent Style="width: 50%">
                                                <CaixaLookupButton OnCaixaSelecionada="OnCaixaSelecionada"/>
                                            </MudCardContent>
                                        </MudItem>
                                        <MudItem xs="12" sm="12" Class="d-flex pt-0">
                                            <MudCardContent Style="width: 32%">
                                                <MudDatePicker Label="Data"
                                                Variant="Variant.Outlined" @bind-Date="data"/>
                                            </MudCardContent>
                                            <MudCardContent Style="width: 32%">
                                                <MudNumericField @bind-Value="quantidadeMeiaEntrada" Label="Meias-Entradas"
                                                Variant="Variant.Outlined"
                                                Disabled="@(sessaoSelecionada is null || sessaoSelecionada?.Meia == false)"
                                                TextChanged="OnAdicionaMeiaEntrada" />
                                            </MudCardContent>
                                            <MudCardContent Style="width: 32%">
                                                <MudNumericField @bind-Value="quantidadeEntradaInteiras"
                                                Label="Entradas Inteiras" Variant="Variant.Outlined" Disabled="true" />
                                            </MudCardContent>
                                        </MudItem>
                                        <MudText Style="margin-top: 20px;" Typo="Typo.h6">Sub-Total:
                                            @subTotal.ToString("C2")
                                        </MudText>
                                    </MudItem>
                                }
                                else
                                {
                                    <MudText>Selecione um Filme e uma Sessão para selecionar os dados da Venda!</MudText>
                                }
                            </MudStep>
                            <MudStep Title="Pagamento">
                                @if (assentos.Count() > 0)
                                {
                                    <MudItem xs="12" sm="12" Class="d-flex">
                                        <MudCardContent Style="width: 50%">
                                            <FormaPagamentoLookupButton OnFormaPagamentoSelecionado="OnFormaPagamentoSelecionado"/>
                                        </MudCardContent>
                                        <MudCardContent Style="width: 50%">
                                            <MudNumericField Immediate="false" Label="Desconto" Format="N2" T="double?"
                                            @bind-Value="desconto" TextChanged="OnDesconto"
                                            Variant="Variant.Outlined" Min="0"/>
                                        </MudCardContent>
                                    </MudItem>
                                    <MudGrid Class="mt-1">
                                        <MudItem xs="6">
                                            <MudText Typo="Typo.h6">
                                                Sub-Total: @subTotal.ToString("C2")
                                            </MudText>
                                        </MudItem>
                                        <MudItem xs="6" Class="d-flex justify-end">
                                            <MudText Typo="Typo.h6">
                                                Total: @total.ToString("C2")
                                            </MudText>
                                        </MudItem>
                                    </MudGrid>
                                }
                                else
                                {
                                    <MudText>Selecione um Filme e uma Sessão para selecionar os dados de Pagamento!</MudText>
                                }
                            </MudStep>
                        </ChildContent>
                        <CompletedContent>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">Salvar</MudButton>
                        </CompletedContent>
                    </MudStepper>
                    @* </MudPaper> *@
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudItem>
</MudGrid>


<style>
    .assento {
    border: 2px solid #9e9e9e;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.2s ease;
    }

    .assento-selecionado {
    background-color: #4caf50;
    color: rgb(39, 39, 47);
    }

    .assento-ocupado {
    background-color: #757575;
    cursor: not-allowed;
    pointer-events: none;
    color: #ddd;
    }
</style>

@code {
    // Valores e controle de venda
    private double subTotal = 0;
    private double total = 0;
    private double? desconto = 0;
    private DateTime? data = DateTime.Today;
    private int quantidadeMeiaEntrada = 0;
    private int quantidadeEntradaInteiras = 0;
    private int totalIngressos = 0;

    // Seleções do usuário
    private int idCaixaSelecionado = 0;
    private Cliente clienteSelecionado;
    private int idFilmeSelecionado = 0;
    private int idFormaPagamentoSelecionado = 0;
    private Sessao sessaoSelecionada;

    // Modelos
    private Venda venda = new Venda();
    private List<Assento> assentos = new();

    // Estado do formulário
    private bool success;

    protected override void OnInitialized() { }

    // Submissão da venda
    private async Task Submit()
    {
        try{
            if(assentos.Count == 0) throw new Exception("Selecione os assentos para finalizar a venda!");
            venda.Cliente ??= new Cliente();
            venda.Caixa ??= new Caixa();
            venda.FormaPagamento ??= new FormaPagamento();
            venda.Cliente.Id = clienteSelecionado.Id;
            venda.Caixa.Id = idCaixaSelecionado;
            venda.FormaPagamento.Id = idFormaPagamentoSelecionado;
            venda.Data = data ?? DateTime.Today;
            venda.Desconto = desconto ?? 0;
            venda.Total = total;
            venda.SubTotal = subTotal;

            var assentosSelecionados = assentos
                .Where(a => a?.Id > 0 && a.Selecionado)
                .Select(a => new { _id = a.Id, _numero = a.Numero })
                .ToArray();

            var url = "venda/ingresso";
            var body = new
            {
                _venda = new
                {
                    _subTotal = venda.SubTotal,
                    _data = venda.Data,
                    _desconto = venda.Desconto,
                    _total = venda.Total,
                    _clienteId = venda.Cliente.Id,
                    _caixaId = venda.Caixa.Id,
                    _formaPagamentoId = venda.FormaPagamento.Id
                },
                _assentos = assentosSelecionados,
                _sessaoId = sessaoSelecionada.Id,
                _quantidadeMeiaEntrada = quantidadeMeiaEntrada
            };
            var response = await _http.PostAsJsonAsync(url, body);

            if (!response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var errors = JsonSerializer.Deserialize<ResponseApi>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (errors?.Errors != null)
                {
                    foreach (var errorList in errors.Errors.Values)
                        foreach (var message in errorList)
                            Snackbar.Add(message, Severity.Error);
                }
                return;
            }
            Snackbar.Add("Venda realizada com sucesso!", Severity.Success);
            NavigationManager.NavigateTo("/venda/ingresso");
        }catch(Exception ex){
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    // Alterna seleção de assentos
    private void AlternarSelecao(Assento assento)
    {
        assento.Selecionado = !assento.Selecionado;
        if (assento.Selecionado)
        {
            subTotal += sessaoSelecionada.Valor;
            quantidadeEntradaInteiras++;
            totalIngressos++;
        }
        else
        {
            subTotal -= sessaoSelecionada.Valor;
            quantidadeEntradaInteiras--;
            totalIngressos--;
        }
    }

    // Classe CSS do assento
    private string GetClasse(Assento assento)
    {
        if (assento.Ocupado) return "assento assento-ocupado";
        return "assento " + (assento.Selecionado ? "assento-selecionado" : "assento-livre");
    }

    // Busca assentos disponíveis
    private async void GetAssentosAsync()
    {
        try
        {
            var queryParams = new Dictionary<string, string>();
            if (sessaoSelecionada.Id != 0 && sessaoSelecionada.Id != null)
                queryParams.Add("idSessao", sessaoSelecionada.Id.ToString());

            var url = QueryHelpers.AddQueryString("assento/livre", queryParams);
            var response = await _http.GetStreamAsync(url);
            using var json = await JsonDocument.ParseAsync(response);

            assentos.Clear();
            foreach (var item in json.RootElement.GetProperty("assentos").EnumerateArray())
            {
                assentos.Add(new Assento
                {
                    Id = item.GetProperty("_id").GetInt32(),
                    Numero = item.GetProperty("_numero").GetInt32()
                });
            }

            for (int i = 1; i <= json.RootElement.GetProperty("totalAssentos").GetInt32(); i++)
            {
                if (!assentos.Any(x => x.Numero == i))
                {
                    assentos.Add(new Assento { Numero = i, Ocupado = true });
                }
            }
            assentos = assentos.OrderByDescending(x => x.Numero).ToList();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    // Validação do formulário
    private void OnValidSubmit(EditContext context)
    {
        success = true;
        StateHasChanged();
    }

    // Callbacks de seleção
    private void OnFilmeSelecionado(int id) => idFilmeSelecionado = id;
    private void OnCaixaSelecionada(int id) => idCaixaSelecionado = id;
    private void OnClienteSelecionada(Cliente cliente) => clienteSelecionado = cliente;
    private void OnFormaPagamentoSelecionado(int id) => idFormaPagamentoSelecionado = id;
    private void OnSessaoSelecionada(Sessao sessao)
    {
        sessaoSelecionada = sessao;
        GetAssentosAsync();
    }

    // Controle de meia-entrada
    private void OnAdicionaMeiaEntrada()
    {
        if (quantidadeMeiaEntrada > 0 && totalIngressos >= quantidadeMeiaEntrada)
            quantidadeEntradaInteiras = totalIngressos - quantidadeMeiaEntrada;
        else if (quantidadeMeiaEntrada == 0)
            quantidadeEntradaInteiras = totalIngressos;
        else
        {
            quantidadeMeiaEntrada = 0;
            quantidadeEntradaInteiras = totalIngressos;
        }
        if (sessaoSelecionada != null)
        {
            subTotal = (sessaoSelecionada.Valor * quantidadeEntradaInteiras) + ((sessaoSelecionada.Valor / 2) * quantidadeMeiaEntrada);
            OnCalculaDesconto();
        }
    }

    // Reset do formulário ao trocar de etapa
    private void OnStepChanged(int step)
    {
        if (step == 0)
        {
            subTotal = 0;
            total = 0;
            desconto = 0;
            quantidadeMeiaEntrada = 0;
            quantidadeEntradaInteiras = 0;
            totalIngressos = 0;
            idFilmeSelecionado = 0;
            sessaoSelecionada = null;
            assentos = new List<Assento>();
        }
    }

    // Desconto
    private void OnDesconto() => OnCalculaDesconto();
    private void OnCalculaDesconto() => total = subTotal - (desconto ?? 0);
}