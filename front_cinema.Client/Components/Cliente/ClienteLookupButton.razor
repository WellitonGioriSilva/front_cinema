@using front_cinema.Client.Models


<MudTextField T="string" Label="Cliente" Variant="Variant.Outlined" Adornment="Adornment.End"
    AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="@OpenLookupDialog" Value="@nomeCliente" />
<MudTextField T="string" Value="@idCliente.ToString()" style="display:none;" InputId="id_cliente" />

@code {
    [Parameter]
    public int? idCliente {get; set;}
    [Parameter]
    public string? nomeCliente {get; set;}
    
    [Parameter]
    public EventCallback<Cliente> OnClienteSelecionada { get; set; }
    Cliente SelectedCliente;

    private async Task OpenLookupDialog()
    {
        var parameters = new DialogParameters();
        var options = new DialogOptions() { MaxWidth = MaxWidth.Medium, FullWidth = true };


        var dialog = DialogService.Show<ClienteLookupDialog>("Selecionar Cliente", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            SelectedCliente = (Cliente)result.Data;
            if (SelectedCliente != null)
            {
                idCliente = SelectedCliente?.Id;
                nomeCliente = SelectedCliente?.Nome;
                await OnClienteSelecionada.InvokeAsync(SelectedCliente);
            }
        }
    }

    [Inject] IDialogService DialogService { get; set; }
}
