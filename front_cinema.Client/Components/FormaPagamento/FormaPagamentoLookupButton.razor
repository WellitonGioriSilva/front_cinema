@using front_cinema.Client.Models


<MudTextField T="string" Label="Forma de Pagamento" Variant="Variant.Outlined" Adornment="Adornment.End"
    AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="@OpenLookupDialog"
    Value="@SelectedFormaPagamento?.Nome" />
<MudTextField T="string" Value="@SelectedFormaPagamento?.Id.ToString()" style="display:none;"
    InputId="id_formaPagamento" />

@code {
    FormaPagamento SelectedFormaPagamento;
    [Parameter]
    public EventCallback<int> OnFormaPagamentoSelecionado { get; set; }

    private async Task OpenLookupDialog()
    {
        var parameters = new DialogParameters();
        var options = new DialogOptions() { MaxWidth = MaxWidth.Medium, FullWidth = true };

        var dialog = DialogService.Show<FormaPagamentoLookupDialog>("Selecionar Forma de Pagamento", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            SelectedFormaPagamento = (FormaPagamento)result.Data;
            if (SelectedFormaPagamento != null)
            {
                await OnFormaPagamentoSelecionado.InvokeAsync(SelectedFormaPagamento.Id);
            }
        }
    }

    [Inject] IDialogService DialogService { get; set; }
}
